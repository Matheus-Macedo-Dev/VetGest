@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ChatNotificationService Notifications
<MudThemeProvider Theme="@Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <header class="app-topbar">
        <a class="app-brand" href="" aria-label="VetGest, página inicial">
            <span class="brand-mark" aria-hidden="true">V</span>
            <span><strong>Vet</strong>Gest</span>
        </a>
        <div class="app-topbar-actions">
            <ChatBell />
            <button class="icon-btn" type="button" aria-label="@(_drawerOpen ? "Fechar menu" : "Abrir menu")" aria-expanded="@_drawerOpen" aria-controls="app-drawer" @onclick="ToggleDrawerAsync" @ref="_toggleButton">
                <MudIcon Icon="@(_drawerOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" aria-hidden="true" />
            </button>
        </div>
    </header>

    <div class="app-overlay @(_drawerOpen ? "open" : null)" @onclick="CloseDrawerAsync" aria-hidden="true"></div>

    <aside id="app-drawer" class="app-sidebar @(_drawerOpen ? "open" : null)" @onkeydown="OnDrawerKeyDown">
        <NavMenu OnClose="CloseDrawerAsync" @ref="_navMenu" />
    </aside>

    <main class="app-main">
        <header class="app-header">
            <div>
                <p class="eyebrow">VETGEST · ESPAÇO DE CUIDADO</p>
                <AuthorizeView>
                    <Authorized><span class="header-status"><span class="status-dot" aria-hidden="true"></span>Conta protegida</span></Authorized>
                    <NotAuthorized><span class="header-status"><span class="status-dot" aria-hidden="true"></span>Entre para continuar</span></NotAuthorized>
                </AuthorizeView>
            </div>
            <ChatBell />
        </header>

        <article class="app-content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _drawerOpen;
    private bool _focusDrawerAfterRender;
    private ElementReference _toggleButton;
    private NavMenu? _navMenu;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await SyncNotificationsAsync(AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDrawerAfterRender && _navMenu is not null)
        {
            _focusDrawerAfterRender = false;
            await _navMenu.FocusCloseButtonAsync();
        }
    }

    private async Task ToggleDrawerAsync()
    {
        if (_drawerOpen)
        {
            await CloseDrawerAsync();
            return;
        }

        _drawerOpen = true;
        _focusDrawerAfterRender = true;
    }

    private async Task CloseDrawerAsync()
    {
        if (!_drawerOpen)
            return;

        _drawerOpen = false;
        await _toggleButton.FocusAsync();
    }

    private async Task OnDrawerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            await CloseDrawerAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authState) =>
        _ = InvokeAsync(() => SyncNotificationsAsync(authState));

    private async Task SyncNotificationsAsync(Task<AuthenticationState> authState)
    {
        var user = (await authState).User;
        if (user.Identity?.IsAuthenticated == true && (user.IsInRole("Vet") || user.IsInRole("Tutor")))
            await Notifications.StartAsync();
        else
            Notifications.Stop();
    }

    public void Dispose() => AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#682E5E",
            Secondary = "#E6999F",
            Tertiary = "#F0DCE9",
            Background = "#FDF7F5",
            Surface = "#ffffff",
            AppbarBackground = "#FDF7F5",
            AppbarText = "#332E32",
            TextPrimary = "#332E32",
            TextSecondary = "#6F6870",
            Divider = "#EADFE4",
            Success = "#9BB79F",
            Warning = "#E5B86A",
            Error = "#C95D67",
            Info = "#682E5E"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Poppins", "Arial", "sans-serif" } },
            H1 = new H1Typography { FontFamily = new[] { "Poppins", "Arial", "sans-serif" } },
            H2 = new H2Typography { FontFamily = new[] { "Poppins", "Arial", "sans-serif" } },
            H3 = new H3Typography { FontFamily = new[] { "Poppins", "Arial", "sans-serif" } }
        }
    };
}
