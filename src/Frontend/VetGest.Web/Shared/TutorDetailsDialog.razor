<MudDialog>
    <DialogContent>
        <MudTextField Value="Tutor.FullName" Label="Nome completo" ReadOnly="true" />
        <MudTextField Value="Tutor.Email" Label="E-mail" ReadOnly="true" />
        <MudTextField Value="@(Tutor.IsActive ? "Ativo" : "Desativado")" Label="Situação da conta" ReadOnly="true" />
        <MudTextField Value="@Tutor.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" Label="Conta criada em" ReadOnly="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AdminTutorDto Tutor { get; set; } = new();

    private void Close() => MudDialog.Close();
}