<span class="vetgest-brand @(Compact ? "vetgest-brand--compact" : null)">
    <img src="images/vetgest-pets-mark.svg" alt="" />
    <span class="vetgest-brand-copy">
        <span class="vetgest-wordmark"><strong>Vet</strong>Gest</span>
        @if (ShowTagline)
        {
            <span class="vetgest-tagline">Cuidando de cada nova vida</span>
        }
    </span>
</span>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool ShowTagline { get; set; }
}
