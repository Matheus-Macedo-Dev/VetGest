<ul class="password-checklist" aria-live="polite">
    @foreach (var rule in PasswordPolicy.Rules)
    {
        var satisfied = !string.IsNullOrEmpty(Password) && rule.IsSatisfied(Password);
        <li class="@RuleClass(satisfied)">
            <MudIcon Icon="@RuleIcon(satisfied)" aria-hidden="true" />
            <span>@rule.Label</span>
        </li>
    }
</ul>
<div class="password-strength" role="status" aria-live="polite">
    <div class="password-strength-track" aria-hidden="true">
        <span class="@($"password-strength-fill password-strength-{Tone}")" style="width: @Percent%"></span>
    </div>
    <p>Força da senha: <strong>@Label</strong>. @Hint</p>
</div>

@code {
    [Parameter] public string? Password { get; set; }

    private bool HasTyped => !string.IsNullOrEmpty(Password);
    private int Satisfied => PasswordPolicy.CountSatisfied(Password);
    private int Total => PasswordPolicy.Rules.Count;

    private int Percent => HasTyped ? Math.Max(15, Satisfied * 100 / Total) : 0;

    private string Tone => Satisfied == Total ? "strong" : Satisfied >= Total - 2 && HasTyped ? "medium" : "weak";

    private string Label => Satisfied == Total ? "Forte" : Tone == "medium" ? "Média" : "Fraca";

    private string Hint
    {
        get
        {
            if (!HasTyped)
                return "Use pelo menos 8 caracteres.";

            if (Satisfied == Total)
                return "Senha pronta.";

            var missing = PasswordPolicy.Rules.Where(rule => !rule.IsSatisfied(Password!)).Select(rule => rule.Label.Replace("Ao menos 1 ", "").Replace("Pelo menos ", ""));
            return $"Falta: {string.Join(", ", missing)}.";
        }
    }

    private string RuleClass(bool satisfied) =>
        satisfied ? "password-rule password-rule-pass"
        : HasTyped ? "password-rule password-rule-fail"
        : "password-rule password-rule-pending";

    private string RuleIcon(bool satisfied) =>
        satisfied ? Icons.Material.Filled.CheckCircle
        : HasTyped ? Icons.Material.Filled.Cancel
        : Icons.Material.Filled.RadioButtonUnchecked;
}
