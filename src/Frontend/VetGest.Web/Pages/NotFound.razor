@page "/not-found"
@layout MainLayout

<PageTitle>Página não encontrada | VetGest</PageTitle>

<section class="not-found-page" aria-labelledby="not-found-title">
    <div class="not-found-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Pets" Size="Size.Large" /></div>
    <span class="section-kicker">Página não encontrada</span>
    <h1 id="not-found-title">Este caminho não levou ao destino</h1>
    <p>O endereço pode estar incorreto ou a página não está mais disponível.</p>
    <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home">Ir para o início</MudButton>
</section>