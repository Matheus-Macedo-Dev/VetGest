@page "/vet-connection"
@attribute [Authorize(Roles = "Vet,Tutor")]
@implements IAsyncDisposable
@using System.Security.Claims
@inject VetConnectionService VetConnectionService
@inject VetConnectionRealtimeService RealtimeService
@inject PetService PetService
@inject PregnancyService PregnancyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Conexão veterinária | VetGest</PageTitle>

<section class="vet-connection-page" aria-labelledby="vet-connection-title">
    @if (_isLoading)
    {
        <div class="state-panel" aria-live="polite"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Carregando conexões...</span></div>
    }
    else if (_state == PageState.Unauthorized)
    {
        <div class="state-panel state-error" role="alert"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" /><div><strong>Sessão não autorizada</strong><span>Entre novamente para acessar as conexões.</span><MudButton Href="login" Variant="Variant.Outlined" Color="Color.Primary">Entrar</MudButton></div></div>
    }
    else if (_state == PageState.Offline)
    {
        <div class="state-panel" role="alert"><MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" /><div><strong>Conexões indisponíveis offline</strong><span>Conecte-se para sincronizar códigos e conexões.</span><MudButton Variant="Variant.Outlined" Color="Color.Primary" @onclick="LoadAsync">Tentar novamente</MudButton></div></div>
    }
    else if (_state == PageState.Error)
    {
        <div class="state-panel state-error" role="alert"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" /><div><strong>Não foi possível carregar</strong><span>@_error</span><MudButton Variant="Variant.Outlined" Color="Color.Primary" @onclick="LoadAsync">Tentar novamente</MudButton></div></div>
    }
    else
    {
        <div class="page-heading"><div><span class="section-kicker">Colaboração segura</span><h1 id="vet-connection-title">@(_isVet ? "Conexão com tutores" : "Conexão veterinária")</h1><p>@(_isVet ? "Gere um código e envie ao tutor. Ele escolhe qual gestação compartilhar com você." : "Digite o código recebido do seu veterinário e escolha qual gestação compartilhar. Você pode encerrar a conexão quando quiser.")</p></div></div>

        @if (_realtimeWarning is not null)
        {
            <MudAlert Severity="Severity.Warning">@_realtimeWarning</MudAlert>
        }

        <div class="connection-grid">
            @if (_isVet)
            {
                <div class="connection-form">
                    <h2>Gerar código</h2>
                    <p>O código é de uso único e expira. O tutor o digita na área "Conexão veterinária" dele.</p>
                    @if (_createError is not null)
                    {
                        <MudAlert Severity="Severity.Error">@_createError</MudAlert>
                    }
                    <MudButton Disabled="@_isCreating" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key" @onclick="CreateCodeAsync">@(_isCreating ? "Gerando..." : "Gerar código")</MudButton>
                    @if (_newCode is not null)
                    {
                        <MudAlert Severity="Severity.Success" Class="mt-2">
                            <strong>@_newCode.InvitationCode</strong>
                            <div>Expira em @_newCode.InvitationExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" @onclick="CopyCodeAsync">Copiar código</MudButton>
                        </MudAlert>
                    }
                </div>
            }

            @if (_isTutor)
            {
                <EditForm Model="_acceptForm" OnValidSubmit="AcceptCodeAsync" class="connection-form">
                    <DataAnnotationsValidator />
                    <h2>Informar código</h2>
                    <p>Escolha a gestação que o veterinário poderá acompanhar (somente leitura).</p>
                    @if (_options.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">Você precisa de um pet com gestação ativa para compartilhar. <a href="pets">Ir para Meus pets</a></MudAlert>
                    }
                    else
                    {
                        <MudSelect T="Guid" @bind-Value="_selectedPregnancyId" Label="Gestação a compartilhar" Required="true">
                            @foreach (var option in _options)
                            {
                                <MudSelectItem Value="@option.PregnancyId">@option.PetName · parto estimado @option.DueDate.ToString("dd/MM/yyyy")</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <MudTextField @bind-Value="_acceptForm.InvitationCode" Label="Código do veterinário" Placeholder="ABC123456789" Required="true" />
                    @if (_acceptError is not null)
                    {
                        <MudAlert Severity="Severity.Error">@_acceptError</MudAlert>
                    }
                    <MudButton ButtonType="ButtonType.Submit" Disabled="@(_isAccepting || _options.Count == 0)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link">@(_isAccepting ? "Validando..." : "Conectar")</MudButton>
                </EditForm>
            }
        </div>

        <section class="connection-list" aria-labelledby="connection-list-title">
            <div class="section-heading"><div><span class="section-kicker">Status atual</span><h2 id="connection-list-title">Conexões</h2></div><span class="entry-count">@_connections.Count conexão(ões)</span></div>
            @if (_connections.Count == 0)
            {
                <p class="empty-note">Nenhuma conexão registrada ainda.</p>
            }
            else
            {
                <div class="connection-items" role="list">
                    @foreach (var connection in _connections)
                    {
                        <article class="connection-item" role="listitem">
                            <div>
                                <div class="exam-meta"><span class="exam-status @StatusClass(connection.Status)">@StatusLabel(connection.Status)</span>@if (IsOpenCode(connection)) { <span>Expira em @connection.InvitationExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span> }</div>
                                <h3>@ConnectionLabel(connection)</h3>
                                @if (!string.IsNullOrWhiteSpace(connection.PetName))
                                {
                                    <p>Pet: @connection.PetName</p>
                                }
                                @if (IsOpenCode(connection))
                                {
                                    <p><strong>Código:</strong> @connection.InvitationCode</p>
                                }
                            </div>
                            <div>
                                @if (connection.Status == "Active")
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="chat" StartIcon="@Icons.Material.Filled.Chat">Chat</MudButton>
                                    @if (_isVet)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href=@($"vet/patients/{connection.Id}") StartIcon="@Icons.Material.Filled.MenuBook">Diário</MudButton>
                                    }
                                }
                                @if (connection.Status != "Revoked")
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_revokingIds.Contains(connection.Id)" StartIcon="@Icons.Material.Filled.LinkOff" @onclick="() => RevokeAsync(connection.Id)">@(IsOpenCode(connection) ? "Cancelar código" : "Encerrar")</MudButton>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    private enum PageState { Ready, Error, Offline, Unauthorized }

    private sealed record ShareOption(Guid PetId, Guid PregnancyId, string PetName, DateTime DueDate);

    private readonly CancellationTokenSource _cts = new();
    private readonly HashSet<Guid> _joinedPregnancies = [];
    private readonly HashSet<Guid> _revokingIds = [];
    private readonly AcceptVetInvitationRequest _acceptForm = new();
    private List<VetConnectionDto> _connections = [];
    private List<ShareOption> _options = [];
    private VetConnectionDto? _newCode;
    private PageState _state;
    private bool _isLoading = true;
    private bool _isCreating;
    private bool _isAccepting;
    private bool _isVet;
    private bool _isTutor;
    private string _userId = string.Empty;
    private string? _error;
    private string? _createError;
    private string? _acceptError;
    private string? _realtimeWarning;
    private Guid _selectedPregnancyId;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _isVet = user.IsInRole("Vet");
        _isTutor = user.IsInRole("Tutor");
        _userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        RealtimeService.ConnectionUpdated += HandleRealtimeUpdateAsync;
        await LoadAsync();
        _ = PollPendingCodesAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _state = PageState.Ready;
        _error = null;
        var result = await VetConnectionService.ListAsync();
        if (!result.Succeeded)
        {
            _state = result.IsUnauthorized ? PageState.Unauthorized : result.IsOffline ? PageState.Offline : PageState.Error;
            _error = result.Error;
            _isLoading = false;
            return;
        }

        _connections = Sort(result.Data ?? []);
        if (_isTutor)
            await LoadShareOptionsAsync();

        _isLoading = false;
        await EnsureRealtimeSubscriptionsAsync();
    }

    private async Task LoadShareOptionsAsync()
    {
        var options = new List<ShareOption>();
        var pets = await PetService.GetPetsAsync();
        foreach (var pet in (pets.Data ?? []).Where(item => item.IsActive))
        {
            var pregnancy = await PregnancyService.GetCurrentAsync(pet.Id);
            if (pregnancy.Succeeded && pregnancy.Data is not null)
                options.Add(new ShareOption(pet.Id, pregnancy.Data.Id, pet.Name, pregnancy.Data.EstimatedDueDate));
        }

        _options = options;
        if (_selectedPregnancyId == Guid.Empty || options.All(option => option.PregnancyId != _selectedPregnancyId))
            _selectedPregnancyId = options.FirstOrDefault()?.PregnancyId ?? Guid.Empty;
    }

    private async Task CreateCodeAsync()
    {
        _createError = null;
        _isCreating = true;
        var result = await VetConnectionService.CreateCodeAsync();
        _isCreating = false;
        if (!result.Succeeded || result.Data is null)
        {
            _createError = result.Error;
            return;
        }

        _newCode = result.Data;
        UpsertConnection(result.Data);
    }

    private async Task AcceptCodeAsync()
    {
        _acceptError = null;
        var option = _options.FirstOrDefault(item => item.PregnancyId == _selectedPregnancyId);
        if (option is null)
        {
            _acceptError = "Escolha a gestação que será compartilhada.";
            return;
        }

        _acceptForm.PetId = option.PetId;
        _acceptForm.PregnancyId = option.PregnancyId;
        _isAccepting = true;
        var result = await VetConnectionService.AcceptInvitationAsync(_acceptForm);
        _isAccepting = false;

        if (!result.Succeeded || result.Data is null)
        {
            _acceptError = result.ValidationErrors is { Count: > 0 }
                ? string.Join(" ", result.ValidationErrors.SelectMany(item => item.Value).Distinct())
                : result.Error;
            return;
        }

        UpsertConnection(result.Data);
        await EnsureRealtimeSubscriptionsAsync();
        _acceptForm.InvitationCode = string.Empty;
    }

    private async Task RevokeAsync(Guid connectionId)
    {
        _revokingIds.Add(connectionId);
        var result = await VetConnectionService.RevokeAsync(connectionId);
        _revokingIds.Remove(connectionId);

        if (!result.Succeeded || result.Data is null)
        {
            _error = result.Error;
            _state = result.IsUnauthorized ? PageState.Unauthorized : result.IsOffline ? PageState.Offline : PageState.Error;
            return;
        }

        UpsertConnection(result.Data);
    }

    private async Task CopyCodeAsync()
    {
        if (_newCode is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newCode.InvitationCode);
    }

    // The vet is not in any realtime group until a tutor redeems the code, so refresh while codes are open.
    private async Task PollPendingCodesAsync()
    {
        if (!_isVet)
            return;

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(8));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (!_connections.Any(IsOpenCode))
                    continue;

                var result = await VetConnectionService.ListAsync(_cts.Token);
                if (result.Succeeded)
                {
                    _connections = Sort(result.Data ?? []);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task EnsureRealtimeSubscriptionsAsync()
    {
        try
        {
            var pregnancies = _connections
                .Where(item => item.Status == "Active" && item.PregnancyId != Guid.Empty)
                .Select(item => item.PregnancyId)
                .Distinct()
                .ToArray();

            if (pregnancies.Length == 0)
                return;

            await RealtimeService.EnsureConnectedAsync();
            foreach (var pregnancyId in pregnancies.Where(id => !_joinedPregnancies.Contains(id)))
            {
                await RealtimeService.JoinPregnancyAsync(pregnancyId);
                _joinedPregnancies.Add(pregnancyId);
            }

            _realtimeWarning = null;
        }
        catch
        {
            _realtimeWarning = "Atualizações em tempo real estão indisponíveis no momento.";
        }
    }

    private Task HandleRealtimeUpdateAsync(VetConnectionUpdatedEvent update)
    {
        var index = _connections.FindIndex(item => item.Id == update.ConnectionId);
        if (index < 0)
            return Task.CompletedTask;

        _connections[index].Status = update.Status;
        return InvokeAsync(StateHasChanged);
    }

    private void UpsertConnection(VetConnectionDto connection)
    {
        var index = _connections.FindIndex(item => item.Id == connection.Id);
        if (index >= 0)
            _connections[index] = connection;
        else
            _connections.Add(connection);

        _connections = Sort(_connections);
    }

    private static List<VetConnectionDto> Sort(IEnumerable<VetConnectionDto> items) =>
        items.OrderByDescending(item => item.AcceptedAt ?? item.InvitationExpiresAt).ToList();

    private static bool IsOpenCode(VetConnectionDto connection) =>
        connection.Status == "Pending" && connection.PregnancyId == Guid.Empty;

    private static string StatusLabel(string status) => status switch
    {
        "Active" => "Ativa",
        "Revoked" => "Encerrada",
        _ => "Aguardando tutor"
    };

    private static string StatusClass(string status) => status switch
    {
        "Active" => "exam-status--upcoming",
        "Revoked" => "exam-status--past",
        _ => "exam-status--soon"
    };

    private string ConnectionLabel(VetConnectionDto connection)
    {
        if (IsOpenCode(connection))
            return "Código aguardando um tutor";

        return connection.VetUserId == _userId
            ? $"Tutor: {connection.TutorName ?? "—"}"
            : $"Veterinário: {connection.VetName ?? "—"}";
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        RealtimeService.ConnectionUpdated -= HandleRealtimeUpdateAsync;
        foreach (var pregnancyId in _joinedPregnancies)
        {
            try { await RealtimeService.LeavePregnancyAsync(pregnancyId); } catch { }
        }
    }
}
