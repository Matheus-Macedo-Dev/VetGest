@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Entrar | VetGest</PageTitle>

<section class="form-page auth-page auth-page--login" aria-labelledby="login-title">
    <header class="auth-brand"><VetGestBrand ShowTagline="true" /></header>
    <div class="form-heading"><h1 id="login-title">Que bom ter você de volta</h1><p>Entre para continuar acompanhando seus pets.</p></div>
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="auth-form">
        <DataAnnotationsValidator />
        @if (_error is not null) { <MudAlert Severity="@(_offline ? Severity.Warning : Severity.Error)">@_error</MudAlert> }
        @if (_showCreateAccountTip)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Primeira vez no VetGest? <a href="register">Crie sua conta de tutor</a> para começar.
            </MudAlert>
        }
        <div class="auth-field">
            <label class="auth-field-label">E-mail*</label>
            <MudTextField @bind-Value="_model.Email" For="@(() => _model.Email)" Label="" aria-label="E-mail" Placeholder="seu@email.com" InputType="InputType.Email" Required="true" autocomplete="email" />
        </div>
        <div class="auth-field">
            <label class="auth-field-label">Senha*</label>
            <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)" Label="" aria-label="Senha" InputType="@(_showPassword ? InputType.Text : InputType.Password)" Required="true" autocomplete="current-password" Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Mostrar ou ocultar senha" />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSubmit)" FullWidth="true">
            @if (_isLoading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="button-inline-spinner" />
                <span>Entrando...</span>
            }
            else
            {
                <span>Entrar</span>
            }
        </MudButton>
        @if (!_isLoading && !CanSubmit)
        {
            <p class="form-hint form-hint-warning auth-login-hint">Informe e-mail e senha para continuar.</p>
        }
        <ValidationSummary />
    </EditForm>
    <div class="auth-divider"><span>ou</span></div>
    <div class="auth-register-prompt"><span>Ainda não tem conta?</span><MudButton Href="register" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true">Criar conta</MudButton></div>
    <div class="auth-safety-note"><MudIcon Icon="@Icons.Material.Filled.Lock" aria-hidden="true" /><span>Seus dados e registros ficam protegidos na sua conta.</span></div>
</section>

@code {
    private readonly LoginRequest _model = new();
    private bool _isLoading;
    private bool _offline;
    private bool _showPassword;
    private bool _showCreateAccountTip;
    private string? _returnUrl;
    private string? _error;

    private bool CanSubmit =>
        !_isLoading &&
        !string.IsNullOrWhiteSpace(_model.Email) &&
        !string.IsNullOrWhiteSpace(_model.Password);

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    protected override void OnInitialized()
    {
        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var reason = ReadQueryValue(currentUri, "reason");
        _showCreateAccountTip = string.Equals(reason, "auth-required", StringComparison.OrdinalIgnoreCase);
        _returnUrl = ReadQueryValue(currentUri, "returnUrl");
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        _isLoading = true;
        _error = null;
        var result = await AuthService.LoginAsync(_model);
        _isLoading = false;
        if (result.Succeeded)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            Navigation.NavigateTo(GetSafeReturnUrl(RoleRouting.HomeFor(authState.User)), replace: true);
            return;
        }

        _offline = result.IsOffline;
        _error = result.Error;
    }

    private string GetSafeReturnUrl(string fallback)
    {
        if (!string.IsNullOrWhiteSpace(_returnUrl) &&
            _returnUrl.StartsWith('/') &&
            !_returnUrl.StartsWith("//") &&
            !_returnUrl.Contains("://", StringComparison.Ordinal))
        {
            return _returnUrl;
        }

        return fallback;
    }

    private static string? ReadQueryValue(Uri uri, string key)
    {
        if (string.IsNullOrWhiteSpace(uri.Query))
        {
            return null;
        }

        foreach (var pair in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var segments = pair.Split('=', 2);
            var currentKey = Uri.UnescapeDataString(segments[0]);
            if (!string.Equals(currentKey, key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            if (segments.Length == 1)
            {
                return string.Empty;
            }

            return Uri.UnescapeDataString(segments[1].Replace('+', ' '));
        }

        return null;
    }
}