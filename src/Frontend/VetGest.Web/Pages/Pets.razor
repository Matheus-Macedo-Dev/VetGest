@page "/pets"
@attribute [Authorize(Roles = "Tutor")]
@inject PetService PetService

<PageTitle>Meus pets | VetGest</PageTitle>

<section class="pets-page" aria-labelledby="pets-title">
    <div class="page-heading"><div><span class="section-kicker">Minha conta</span><h1 id="pets-title">Meus pets</h1><p>Todos os seus companheiros em um só lugar.</p></div><MudButton Href="pets/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Adicionar pet</MudButton></div>
    @if (_isLoading)
    {
        <div class="state-panel" aria-live="polite"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Carregando seus pets...</span></div>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="@(_offline ? Severity.Warning : Severity.Error)">@_error</MudAlert>
    }
    else if (_pets.Count == 0)
    {
        <section class="state-panel" aria-live="polite"><MudIcon Icon="@Icons.Material.Filled.Pets" Size="Size.Large" /><div><strong>Nenhum pet cadastrado</strong><span>Cadastre um pet para começar seu acompanhamento.</span><MudButton Href="pets/new" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Cadastrar primeiro pet</MudButton></div></section>
    }
    else
    {
        <div class="pet-list pet-grid" role="list">
            @foreach (var pet in _pets)
            {
                <article class="pet-card pet-profile-card" role="listitem">
                    <div class="pet-avatar" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Pets" Size="Size.Large" /></div>
                    <div class="pet-profile-info">
                        <div class="pet-profile-title"><h2>@pet.Name</h2><span class="pet-status @(pet.IsActive ? null : "pet-status--inactive")">@(pet.IsActive ? "Ativo" : "Inativo")</span></div>
                        <p>@SpeciesLabel(pet.Species)@(string.IsNullOrWhiteSpace(pet.Breed) ? string.Empty : $" · {pet.Breed}")</p>
                        @if (pet.IsActive)
                        {
                            <MudButton Href=@($"pets/{pet.Id}/pregnancy/new") Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PregnantWoman">Registrar gestação</MudButton>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<PetDto> _pets = [];
    private bool _isLoading = true;
    private bool _offline;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await PetService.GetPetsAsync();
        _isLoading = false;
        if (result.Succeeded && result.Data is not null) { _pets = result.Data; return; }
        _offline = result.IsOffline;
        _error = result.Error;
    }

    private static string SpeciesLabel(string species) => species switch
    {
        "Dog" => "Cão",
        "Cat" => "Gato",
        _ => species
    };
}