@page "/definir-senha"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Definir senha | VetGest</PageTitle>

<section class="form-page" aria-labelledby="set-password-title">
    <div class="form-heading"><span class="section-kicker">Primeiro acesso</span><h1 id="set-password-title">Defina sua senha</h1><p>Escolha uma senha para acessar sua conta de veterinário.</p></div>
    @if (!_hasLink)
    {
        <MudAlert Severity="Severity.Error">Link inválido. Solicite um novo link ao administrador do VetGest.</MudAlert>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            @if (_error is not null) { <MudAlert Severity="@(_offline ? Severity.Warning : Severity.Error)">@_error</MudAlert> }
            <MudTextField Value="_model.Email" ReadOnly="true" Label="E-mail" />
            <MudTextField @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)" Label="Nova senha" InputType="@(_showPassword ? InputType.Text : InputType.Password)" Required="true" autocomplete="new-password" Immediate="true"
                          Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" OnAdornmentClick="() => _showPassword = !_showPassword" AdornmentAriaLabel="Mostrar ou ocultar senha" />
            <PasswordStrengthMeter Password="@_model.NewPassword" />
            <MudTextField @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)" Label="Confirmar senha" InputType="@(_showPassword ? InputType.Text : InputType.Password)" Required="true" autocomplete="new-password" Immediate="true"
                          Error="@(!string.IsNullOrEmpty(_model.ConfirmPassword) && !PasswordsMatch)" ErrorText="As senhas não conferem." />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isLoading || !CanSubmit)" FullWidth="true" StartIcon="@Icons.Material.Filled.LockReset">@(_isLoading ? "Salvando..." : "Definir senha e entrar")</MudButton>
            <ValidationSummary />
        </EditForm>
    }
</section>

@code {
    private readonly SetPasswordRequest _model = new();
    private bool _hasLink;
    private bool _showPassword;

    private bool PasswordsMatch => string.Equals(_model.NewPassword, _model.ConfirmPassword, StringComparison.Ordinal);

    private bool CanSubmit => PasswordPolicy.IsSatisfied(_model.NewPassword) && PasswordsMatch;
    private bool _isLoading;
    private bool _offline;
    private string? _error;

    protected override void OnInitialized()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => pair.Split('=', 2))
            .Where(parts => parts.Length == 2)
            .ToDictionary(parts => Uri.UnescapeDataString(parts[0]), parts => Uri.UnescapeDataString(parts[1].Replace('+', ' ')), StringComparer.OrdinalIgnoreCase);

        _model.Email = query.GetValueOrDefault("email") ?? string.Empty;
        _model.Token = query.GetValueOrDefault("token") ?? string.Empty;
        _hasLink = _model.Email.Length > 0 && _model.Token.Length > 0;
    }

    private async Task SubmitAsync()
    {
        _isLoading = true;
        _error = null;
        var result = await AuthService.SetPasswordAsync(_model);
        _isLoading = false;
        if (result.Succeeded)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            Navigation.NavigateTo(RoleRouting.HomeFor(authState.User), replace: true);
            return;
        }

        _offline = result.IsOffline;
        _error = result.ValidationErrors is { Count: > 0 }
            ? string.Join(" ", result.ValidationErrors.SelectMany(item => item.Value).Distinct())
            : result.Error;
    }
}
