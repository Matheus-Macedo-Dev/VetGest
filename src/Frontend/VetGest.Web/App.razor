@using Microsoft.AspNetCore.Components.Authorization
@using VetGest.Web.Services.Auth
@inject CustomAuthenticationStateProvider AuthenticationStateProvider

<CascadingAuthenticationState>
    @if (!_initialized)
    {
        <div class="state-panel" aria-live="polite"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Carregando sua sessão...</span></div>
    }
    else
    {
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized Context="authContext">
                        @if (authContext.User.Identity?.IsAuthenticated == true)
                        {
                            <div class="state-panel state-error" role="alert"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" /><div><strong>Sem permissão</strong><span>Sua conta não tem acesso a esta página.</span><MudButton Href="@RoleRouting.HomeFor(authContext.User)" Variant="Variant.Outlined" Color="Color.Primary">Ir para minha área</MudButton></div></div>
                        }
                        else
                        {
                            <RedirectToLogin />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    }
</CascadingAuthenticationState>

@code {
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.InitializeAsync();
        _initialized = true;
    }
}
