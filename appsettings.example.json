{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=VetGestDb;Trusted_Connection=true;"
  },
  "Jwt": {
    "SecretKey": "replace-with-a-secure-random-key-of-at-least-32-characters",
    "Issuer": "VetGest.API",
    "Audience": "VetGest.Client",
    "ExpiresInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-frontend-domain.example.com",
      "https://your-secondary-frontend-domain.example.com"
    ],
    "AllowedOriginsCsv": "https://your-frontend-domain.example.com,https://your-secondary-frontend-domain.example.com"
  },
  "VetConnections": {
    "InvitationTtlDays": 7,
    "MaxInvitationTtlDays": 14
  }
}
