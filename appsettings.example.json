{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=VetGestDb;Trusted_Connection=true;"
  },
  "Jwt": {
    "SecretKey": "replace-with-a-secure-random-key-of-at-least-32-characters",
    "Issuer": "VetGest.API",
    "Audience": "VetGest.Client",
    "ExpiresInMinutes": 60
  },
  "VetConnections": {
    "InvitationTtlDays": 7,
    "MaxInvitationTtlDays": 14
  }
}
